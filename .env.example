# Project Atlas - Database & Environment Configuration

# Database Host (usually localhost or 127.0.0.1)
DB_HOST=localhost

# Database Port (MySQL default is 3306)
DB_PORT=3306

# Database Name (existing database created in MySQL Workbench)
DB_NAME=project_atlas

# MySQL Username (e.g. root)
DB_USER=root

# MySQL Password
DB_PASSWORD=your_mysql_password
