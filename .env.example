# Project Atlas - Database & Environment Configuration

# Database Configuration (existing database created in MySQL Workbench)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=project_atlas
DB_USER=root
DB_PASSWORD=your_mysql_password

# Ollama Local LLM & Embeddings Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3.2:3b
OLLAMA_EMBED_MODEL=nomic-embed-text

# ChromaDB Vector Storage Configuration
CHROMA_PERSIST_DIR=data/chroma_db
CHROMA_COLLECTION_NAME=atlas_reports

# Ingestion & Chunking Configuration
REPORTS_DIR=data/reports
CHUNK_SIZE=600
CHUNK_OVERLAP=100
